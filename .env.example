# ============================================================
# Smart Wi-Fi Bandwidth Sharing — Environment Configuration
# ============================================================
# Copy this file to `.env` and adjust values for your environment.
# `LIVE_NETWORK_MODE` controls how /api/network/stats is populated.
#
#   LIVE_NETWORK_MODE=false  -> deterministic research simulation
#   LIVE_NETWORK_MODE=true   -> real runtime local measurements
#                               (ICMP/TCP latency to localhost, host
#                               interface byte counters, derived
#                               throughput). Packet loss and Wi-Fi
#                               link capacity remain honestly
#                               reported as UNAVAILABLE because they
#                               cannot be measured from a generic
#                               host without router/AP telemetry.
# ============================================================

LIVE_NETWORK_MODE=false

# --- Database (legacy MySQL config — currently unused; the app
#     persists accounts to a local SQLite file in database/). ---
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=smart_wifi
MYSQL_PORT=3306
